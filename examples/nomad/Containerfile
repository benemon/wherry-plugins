# Builds a Nomad receiver image from the repository root.
# docker build -f examples/nomad/Containerfile --build-arg VERSION=<version> --build-arg WHERRY_VERSION=<version> .
# examples/nomad/wherry-receiver.nomad.hcl runs it with the arguments receiver run --config-file /local/config.yaml,
# rendering the local configuration examples/nomad/config.yaml and the bundle it names into the task.
FROM --platform=$BUILDPLATFORM ghcr.io/sigstore/cosign/cosign:v3.1.4@sha256:0f06154836d2de34f887a5c273506d52ca43edaa1d9e53e6510fa78a48f69c2d AS cosign

FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.27@sha256:e519d3b0a5b285e5aa53ab9eef02bc6bbb9cb04608389b743a136a9ce75f0d1e AS build
ARG TARGETARCH
ARG VERSION=dev
WORKDIR /src
COPY nomad/ .
RUN CGO_ENABLED=0 GOARCH=$TARGETARCH go build -trimpath -ldflags "-X main.version=${VERSION}" -o /out/wherry-plugin-nomad .

FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.27@sha256:e519d3b0a5b285e5aa53ab9eef02bc6bbb9cb04608389b743a136a9ce75f0d1e AS fetch
ARG WHERRY_VERSION
ARG TARGETARCH
ARG WHERRY_OS=linux
ARG WHERRY_ARCH
COPY --from=cosign /ko-app/cosign /usr/local/bin/cosign
WORKDIR /fetch
RUN test -n "$WHERRY_VERSION" && \
    base="https://github.com/benemon/wherry/releases/download/$WHERRY_VERSION" && \
    archive="wherry_${WHERRY_VERSION}_${WHERRY_OS}_${WHERRY_ARCH:-$TARGETARCH}.tar.gz" && \
    curl -fsSL --remote-name-all "$base/$archive" "$base/checksums.txt" "$base/checksums.txt.sigstore.json" && \
    cosign verify-blob checksums.txt --bundle checksums.txt.sigstore.json \
      --certificate-identity-regexp '^https://github\.com/benemon/wherry/\.github/workflows/release\.yml@refs/tags/v' \
      --certificate-oidc-issuer https://token.actions.githubusercontent.com && \
    grep "  $archive\$" checksums.txt | sha256sum -c - && \
    tar -xzf "$archive" --strip-components=1 "${archive%.tar.gz}/wherry"

# The verified wherry binary alone, for the CLI outside Nomad: --target wherry --output type=local,dest=DIR.
FROM scratch AS wherry
COPY --from=fetch /fetch/wherry /wherry

FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8@sha256:f26ef64172ea61f5ac5ba4be8c5c738bf8760b22b3e5148ce7b40f7308ab32db
COPY --from=fetch --chown=0:0 --chmod=0755 /fetch/wherry /usr/local/bin/wherry
COPY --from=build --chown=0:0 --chmod=0755 /out/wherry-plugin-nomad /usr/local/libexec/wherry/plugins/wherry-plugin-nomad
RUN install -d -o 0 -g 0 -m 0775 /var/lib/wherry
USER 1001:0
ENTRYPOINT ["/usr/local/bin/wherry"]
